# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated list of allowed Telegram chat IDs (get yours from @userinfobot)
ALLOWED_CHAT_IDS=

# Default server: KR/JP/GLB, CN, etc. (matches the dropdown text on the coupon page)
DEFAULT_SERVER=KR/JP/GLB

# Set to 1 to run Chrome headless, 0 to show the window
HEADLESS=1
